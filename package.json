{
  "name": "testflow",
  "version": "1.72.0",
  "description": "Editor Markdown leve para documentação de QA (Raw, Preview editável, Mermaid).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "app": "vite build && vite preview",
    "preview": "vite preview",
    "skill": "node scripts/build-skill.mjs",
    "test": "tsx scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:perf": "playwright test tests/e2e/perf.spec.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.mcp.json",
    "mcp": "tsx mcp/main.ts",
    "mcp:build": "node scripts/build-mcp.mjs",
    "extensao": "node scripts/build-extension.mjs",
    "reporter": "node scripts/build-reporter.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/turndown": "^5.0.6",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "zod": "^3.25.76"
  },
  "private": true,
  "type": "module"
}
